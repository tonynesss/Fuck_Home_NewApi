# Copy this file to `keystore.properties` (same directory) and fill in your own values.
# `keystore.properties` is git-ignored, so the keystore and its passwords are never committed.
#
# Generate a keystore first, for example:
#
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 \
#           -alias fuckhome -storetype PKCS12
#
# Relative paths are resolved against the repository root.

storeFile=release.jks
storePassword=
keyAlias=fuckhome
keyPassword=
